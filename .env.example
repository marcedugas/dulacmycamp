# ─── Dulac My Camp — API service (services/api) ───

# Postgres. Railway injects this automatically when you attach a Postgres
# plugin; set it by hand for local development.
DATABASE_URL=postgres://dulac:dulac@localhost:5432/dulacmycamp

# Signing key for session JWTs. Any long random string; rotating it signs
# everyone out. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-32-plus-random-bytes

# Transactional email (https://resend.com). Leave RESEND_API_KEY unset in
# local development and the API logs emails instead of sending them —
# handy for reading OTP codes out of the server log.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Dulac My Camp <no-reply@dulacmycamp.com>

# Public origin of the React app. Used for CORS and for links inside emails.
FRONTEND_URL=http://localhost:5173

# Optional. A previous origin of the React app, kept in the CORS allow-list
# while links built from it are still in circulation. Leave unset unless a
# domain move is in flight; unsetting it retires the old origin, no deploy.
LEGACY_FRONTEND_URL=

# Public origin of THIS API. The owner's one-click approve/deny buttons point
# here, so it must be reachable from their inbox — not localhost in production.
API_BASE_URL=http://localhost:8080

# Bootstrap fallback for the booking approve/deny email. The real recipient
# list is the `is_owner` flag on user accounts, toggled from the admin panel's
# Users tab, and any number of users may carry it. This address is used ONLY
# when no user is flagged — a fresh database, say — and the API logs a warning
# when it falls back. Safe to leave unset once an owner is flagged.
OWNER_EMAIL=

# Admin notification address. Gets an informational copy, no action buttons.
ADMIN_EMAIL=marc@recoresystems.net

# NOAA tide station for the tide widget. 8762928 is Cocodrie (29.245, -90.662),
# the closest gauge to Dulac. NOTE: 8762075 is Port Fourchon, ~50 mi east.
NOAA_STATION_ID=8762928

# Adults the camp sleeps. Over this, bookings are flagged but never blocked.
CAPACITY_ADULTS=10

# Optional. BIND_ADDR wins; otherwise PORT is used (Railway sets PORT).
BIND_ADDR=0.0.0.0:8080
LOG_LEVEL=info,dulacmycamp_api=debug

# NOTE: APPROVE_TOKEN_SECRET is intentionally absent — see README
# ("Deviations from the spec"). Approve/deny tokens are 256-bit random values
# stored single-use in the database, so there is no secret to configure.


# ─── Web app (apps/web) — build-time, Vite inlines these ───

# Origin of the API. Leave blank in development: the Vite dev server proxies
# /api to localhost:8080 for you.
VITE_API_URL=
