{
  "name": "dulacmycamp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @dulacmycamp/web dev",
    "build": "pnpm --filter @dulacmycamp/web build",
    "typecheck": "pnpm --filter @dulacmycamp/web typecheck",
    "api:check": "cargo check --manifest-path services/api/Cargo.toml --all-targets",
    "api:test": "cargo test --manifest-path services/api/Cargo.toml",
    "api:clippy": "cargo clippy --manifest-path services/api/Cargo.toml --all-targets -- -D warnings",
    "api:fmt": "cargo fmt --manifest-path services/api/Cargo.toml --all",
    "api:dev": "cargo run --manifest-path services/api/Cargo.toml"
  },
  "packageManager": "pnpm@9.12.0"
}
